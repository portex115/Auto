{
  "name": "reels-studio",
  "productName": "Reels Studio",
  "version": "0.1.7",
  "description": "Нарезки стримов в вертикаль: поиск моментов, раскладки, субтитры, монтаж под несколько каналов, папки для автозалива",
  "main": "main.js",
  "author": "Alex",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "icons": "node scripts/copy-icons.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@fontsource-variable/onest": "5.3.1",
    "adm-zip": "0.6.1",
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^26.0.0",
    "lucide-static": "1.69.0"
  },
  "build": {
    "appId": "com.dayzerorules.reelsstudio",
    "productName": "Reels Studio",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "assets/fonts/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "ReelsStudio-Setup.exe",
      "shortcutName": "Reels Studio"
    }
  }
}
